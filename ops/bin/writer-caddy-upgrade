#!/usr/bin/env bash
# Caddy 的受控升级（以 root 运行，由 writer-caddy-upgrade.timer 每周触发，也可以手动运行）。
#
# Caddy 的补丁版本也可能带破坏性变更（例如 2026-11-04 的 v2.11.8 改动了 try_files 与 handle_errors 的行为），
# 所以 caddy 包平时 apt-mark hold，不交给 unattended-upgrades 盲目升级。本脚本的做法：
#   1. 发现新版本后，先解出新版本的二进制，用它校验现行配置（含各站点导入的规则）；
#   2. 通过才安装，装上后跑当前站点版本附带的 URL 合同（见 self_check）；
#   3. 任何一步失败，都装回原版本并记日志（journalctl -t writer-caddy-upgrade 可查）。
set -euo pipefail

readonly TAG=writer-caddy-upgrade
readonly CADDY_LIST=sources.list.d/caddy-stable.list

log() {
	logger -t "$TAG" -- "$*"
	echo "$*"
}

# 从本机按正式主机名请求一个路径，打印状态码（连不上时是 000）。
local_status() {
	curl -sS --max-time 15 -o /dev/null -w '%{http_code}' --resolve writer.drakeet.com:443:127.0.0.1 "https://writer.drakeet.com$1"
}

# 自检：服务在运行，并且正式站当前版本附带的 URL 合同全部通过（docs/rebuild.md 5.5）。合同逐条覆盖地址映射、语言协商、
# 响应头与错误页，补丁版本改动 try_files、改写或 handle_errors 时都能被发现，比只查几个地址可靠。
# 当前版本没有附带合同时（例如回滚到了第 C 步之前的旧站版本），退回只查三项：Apple 关联域名文件 200，首页 200 或跳转，
# 不存在的路径 404。
self_check() {
	systemctl is-active --quiet caddy || return 1
	local contract=/srv/writer.drakeet.com/current/checks/contract.py result
	if [[ -f "$contract" ]]; then
		if ! result="$(python3 -I "$contract" --site writer.drakeet.com 2>&1)"; then
			log "URL 合同不通过：$(grep -m 5 '^不通过' <<<"$result" | tr '\n' ' ')"
			return 1
		fi
		return 0
	fi
	[[ "$(local_status /.well-known/apple-app-site-association)" == 200 ]] || return 1
	[[ "$(local_status /)" =~ ^(200|301|302|308)$ ]] || return 1
	[[ "$(local_status /writer-caddy-upgrade-self-check)" == 404 ]]
}

# 返回 apt-get 的结果，无论成败都重新 hold，免得 unattended-upgrades 接手。
# 函数在 if 条件里调用时 set -e 不生效，所以显式记下 apt-get 的退出码。
install_version() {
	local status=0
	apt-mark unhold caddy >/dev/null
	DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --allow-downgrades "caddy=$1" || status=$?
	apt-mark hold caddy >/dev/null
	return "$status"
}

# 只刷新 Caddy 官方源的索引，不影响系统其余软件源。
apt-get update -qq -o Dir::Etc::sourcelist="$CADDY_LIST" -o Dir::Etc::sourceparts=- -o APT::Get::List-Cleanup=0

installed="$(dpkg-query -W -f='${Version}' caddy)"
candidate="$(apt-cache policy caddy | awk '/Candidate:/ {print $2}')"
if [[ -z "$candidate" || "$candidate" == "(none)" ]]; then
	log "查不到 caddy 的候选版本，跳过"
	exit 1
fi
if dpkg --compare-versions "$candidate" le "$installed"; then
	echo "Caddy 已是最新：$installed"
	exit 0
fi

work="$(mktemp -d)"
trap 'rm -rf -- "$work"' EXIT
(cd "$work" && apt-get download -qq "caddy=$candidate")
dpkg-deb -x "$work"/caddy_*.deb "$work/root"

# 以 caddy 身份校验（目录放开为 0755，caddy 用户才能执行解出的二进制）：校验会打开日志文件，
# 以 root 运行可能把日志文件建成 root 所有，正在运行的 Caddy 重启后就打不开。
chmod 0755 "$work"
if ! runuser -u caddy -- "$work/root/usr/bin/caddy" validate --config /etc/caddy/Caddyfile --adapter caddyfile \
	>"$work/validate.log" 2>&1; then
	log "新版本 $candidate 拒绝现行配置，不升级：$(tail -n 5 "$work/validate.log" | tr '\n' ' ')"
	exit 1
fi

if install_version "$candidate"; then
	sleep 5
	if self_check; then
		log "Caddy 已从 $installed 升级到 $candidate"
		exit 0
	fi
	log "升级到 $candidate 后自检失败，装回 $installed"
else
	log "安装 $candidate 失败，装回 $installed"
fi

if install_version "$installed"; then
	sleep 5
	self_check || log "装回 $installed 后自检仍失败，需要人工处理"
else
	log "装回 $installed 也失败了，需要人工处理"
fi
exit 1
