#!/usr/bin/env bash
# 从 R2 拉取桌面版 JAR，放进国内镜像目录（对外地址 https://writer.drakeet.com/ocat/jars/）。
#
# 国内有的用户连不上 Cloudflare，所以 R2（kuromi.drakeet.cn）上的 JAR 要在这台国内服务器上也放一份。
# 由桌面仓库的 buildAllJars.sh 在 JAR 传到 R2 之后经 ssh 以 drakeet 身份调用：
#   writer-jars-sync <版本> <文件名>=<sha256> [<文件名>=<sha256> ...]
# 可以放心重跑：已存在且哈希一致的文件直接跳过。
#
# 清理规则：按版本号保留最近 KEEP_VERSIONS 个版本，永不删除本次同步的版本。
# 镜像该有哪个版本，取决于已部署的 rebase-server 下发哪个版本，而它由人手动部署，常常落后几个版本；
# 只留最新版会在服务端部署之前删掉它仍在下发的文件（见 docs/rebuild.md 5.6）。
set -euo pipefail

readonly JARS=/srv/writer.drakeet.com/jars
# 临时目录不在网站对外提供的路径下，下载到一半的文件不会被访问到。
readonly INCOMING=/srv/writer.drakeet.com/jars-incoming
readonly R2_BASE=https://kuromi.drakeet.cn
readonly KEEP_VERSIONS=7
readonly PLATFORMS='Windows-x64|macOS-x64|macOS-aarch64'
# 桌面版 5.3.0 起产物文件名的前缀从 PureWriter2 改为 PureWriter；镜像里两种都有，服务端仍在下发的旧版本是旧前缀。
readonly PREFIX='PureWriter2?'

die() {
	echo "writer-jars-sync: $*" >&2
	exit 1
}

[[ $# -ge 2 ]] || die "用法：writer-jars-sync <版本> <文件名>=<sha256> ..."
version="$1"
shift
[[ "$version" =~ ^[0-9]+(\.[0-9]+)+$ ]] || die "版本号格式不对：$version"
escaped_version="${version//./\\.}"

mkdir -p "$INCOMING"
# 同一时间只允许一个同步在跑，免得两次发版的下载互相覆盖。
exec 9>"$INCOMING/.lock"
flock -n 9 || die "已有另一个同步在运行"

for pair in "$@"; do
	name="${pair%%=*}"
	sha="${pair#*=}"
	[[ "$name" =~ ^${PREFIX}-${escaped_version}-(${PLATFORMS})\.jar$ ]] || die "文件名不对：$name"
	[[ "$sha" =~ ^[0-9a-f]{64}$ ]] || die "sha256 格式不对：$name"

	target="$JARS/$name"
	if [[ -f "$target" ]] && [[ "$(sha256sum "$target" | cut -d' ' -f1)" == "$sha" ]]; then
		echo "已存在，跳过：$name"
		continue
	fi

	# 临时文件名带上哈希：同名文件重新构建过时，不会与上一次没下完的文件混在一起。
	part="$INCOMING/$name.$sha.part"
	rm -f -- "$part"
	# 查询串让 Cloudflare 的边缘缓存键与旧请求不同，同名文件重传后不会拿到旧内容。
	curl -fsSL --retry 5 --retry-delay 5 --retry-all-errors --connect-timeout 20 --max-time 1800 \
		-o "$part" "$R2_BASE/$name?sha256=$sha"
	actual="$(sha256sum "$part" | cut -d' ' -f1)"
	if [[ "$actual" != "$sha" ]]; then
		rm -f -- "$part"
		die "sha256 不符：$name（期望 $sha，实际 $actual）"
	fi
	# 先设好权限再原子地放到位：mktemp 一类的默认权限 0600 会让 Caddy 读不到。
	chmod 0644 "$part"
	mv -f -- "$part" "$target"
	echo "已同步：$name"
done

# 列出镜像里现有的版本号，按版本号排序，保留最新的 KEEP_VERSIONS 个。
mapfile -t versions < <(
	find "$JARS" -maxdepth 1 -type f -name 'PureWriter*.jar' -printf '%f\n' \
		| sed -nE "s/^${PREFIX}-([0-9]+(\.[0-9]+)+)-(${PLATFORMS})\.jar$/\1/p" \
		| sort -uV
)
keep="$(printf '%s\n' "${versions[@]}" | tail -n "$KEEP_VERSIONS")"
for v in "${versions[@]}"; do
	if [[ "$v" == "$version" ]] || grep -qxF -- "$v" <<<"$keep"; then
		continue
	fi
	for prefix in PureWriter PureWriter2; do
		rm -f -- "$JARS/$prefix-$v-Windows-x64.jar" "$JARS/$prefix-$v-macOS-x64.jar" "$JARS/$prefix-$v-macOS-aarch64.jar"
	done
	echo "已清理旧版本：$v"
done
